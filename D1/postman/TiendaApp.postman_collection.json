{
  "info": {
    "name": "TiendaApp - JWT y roles",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Una petición por endpoint de TiendaApp. El Login guarda el JWT en la variable {{token}}; las demás peticiones lo envían como Bearer token."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090/api/v1/tienda"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "loginUser",
      "value": "admin"
    },
    {
      "key": "loginPassword",
      "value": "Admin2026!"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "0. Autenticación",
      "item": [
        {
          "name": "POST /auth/register - Registrar CLIENTE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"cliente1\",\n  \"email\": \"cliente1@tienda.com\",\n  \"password\": \"Cliente123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Siempre crea un CLIENTE. Username o email repetido: 409."
          }
        },
        {
          "name": "POST /auth/login - Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"{{loginUser}}\",\n  \"password\": \"{{loginPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Acepta username o email. Guarda el jwt en la variable {{token}}. Credenciales malas o usuario inactivo: 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200 && body.data && body.data.jwt) {",
                  "    pm.collectionVariables.set('token', body.data.jwt);",
                  "    console.log('Token guardado en la variable {{token}}');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/refreshtoken - Renovar token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refreshtoken",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refreshtoken"
              ]
            },
            "description": "Usa el token actual ({{token}}) y guarda el nuevo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (pm.response.code === 200 && body.data && body.data.jwt) {",
                  "    pm.collectionVariables.set('token', body.data.jwt);",
                  "    console.log('Token guardado en la variable {{token}}');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Usuarios",
      "item": [
        {
          "name": "GET /users/me - Mi perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "GET /users - Listar usuarios (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "POST /users - Crear usuario con rol (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"vendedor1\",\n  \"email\": \"vendedor1@tienda.com\",\n  \"password\": \"Vendedor123!\",\n  \"rolId\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "rolId: 1=ADMIN, 2=CLIENTE, 3=VENDEDOR"
          }
        },
        {
          "name": "PATCH /users/{id}/role - Cambiar rol (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "role"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rolId\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PATCH /users/{id}/status - Activar/desactivar (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{userId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
