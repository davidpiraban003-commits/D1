    },
    {
      "name": "3. Productos",
      "item": [
        {
          "name": "GET /products - Catálogo (público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}",
                  "disabled": true
                }
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Activa el parámetro categoryId para filtrar por categoría."
          }
        },
        {
          "name": "GET /products/{id} - Detalle (público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "GET /products/mine - Mis productos (VENDEDOR)",
          "request": {
            "method": "GET",
            "header": [],
