    {
      "name": "5. Evidencias",
      "item": [
        {
          "name": "2. Token ausente (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "No envía el header Authorization."
          }
        },
        {
          "name": "3. Token expirado (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Usa {{token}}. Haz login con JWT_EXPIRATION_MINUTES=1, espera más de 1 minuto y envía esta petición."
          }
        },
        {
          "name": "4. Rol no permitido (403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Entra como CLIENTE o VENDEDOR: GET /users es solo para ADMIN."
          }
        },
        {
          "name": "5. Producto ajeno (403)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Intento de edici\\u00f3n ajena\",\n  \"description\": \"Descripci\\u00f3n del producto\",\n  \"price\": 1,\n  \"stock\": 1,\n  \"categoryId\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Entra como un VENDEDOR distinto al dueño del producto."
          }
        },
        {
          "name": "6. Pedido sin stock (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
