              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 999999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Entra como CLIENTE. Cantidad mayor al stock disponible."
          }
        }
