            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teclado mec\\u00e1nico\",\n  \"description\": \"Descripci\\u00f3n del producto\",\n  \"price\": 150000,\n  \"stock\": 5,\n  \"categoryId\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "El dueño (seller) sale del token, no del body."
          }
        },
        {
          "name": "PUT /products/{id} - Editar producto (VENDEDOR dueño o ADMIN)",
          "request": {
            "method": "PUT",
